# Narancs Signage – egyszeri telepítés az első indításkor (Raspberry Pi image)
[Unit]
Description=Narancs Signage first boot setup
Wants=network-online.target
# a cloud-init.target-re NEM várhat: a Trixie-n az a multi-user.target után jön, ami körkörös sorrendet adna,
# és a systemd ezt a feladatot dobná el. Az Imager beállításai (Wi-Fi, felhasználó) már a hálózat előtt lefutnak.
After=network-online.target
# a bejelentkezés csak utána jelenjen meg, hogy a képernyőn látsszon a telepítés folyamata
Before=getty@tty1.service
ConditionPathExists=!/var/lib/narancs-signage-firstboot.done

[Service]
Type=oneshot
ExecStart=/usr/local/lib/narancs-signage/firstboot.sh
StandardOutput=journal+console
StandardError=journal+console
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
